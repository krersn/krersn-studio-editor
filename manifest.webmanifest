{
  "name": "Krersn Studio Editör",
  "short_name": "Krersn Studio",
  "description": "Tarayıcıda çalışan katmanlı görsel düzenleyici — Shorts, Play Store ve sosyal medya görselleri için.",
  "lang": "tr",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#131316",
  "theme_color": "#131316",
  "categories": ["photo", "graphics", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "image/*": [".png", ".jpg", ".jpeg", ".webp"] } }
  ]
}
